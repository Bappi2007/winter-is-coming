# API server
PORT=4000

# Exact frontend origin(s), comma-separated if you deploy more than one.
CLIENT_ORIGIN=http://localhost:5173

# Identifies requests made to OpenStreetMap Nominatim.
NOMINATIM_REVERSE_URL=https://nominatim.openstreetmap.org/reverse
NOMINATIM_USER_AGENT=WinterIsComing/1.0 (weather web app)
# Optional contact address for Nominatim usage-policy compliance.
NOMINATIM_CONTACT=
